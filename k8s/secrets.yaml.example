# ==========================================
# Kubernetes Secrets (Optional)
# ==========================================
#
# Store sensitive information like:
# - Slack webhook URLs
# - PagerDuty API keys
# - Prometheus authentication tokens
#
# IMPORTANT: Never commit actual secrets to git!
# This is a template. Create the actual secret using:
#   kubectl create secret generic green-but-dead-detector-secrets \
#     --from-literal=slack-webhook-url=YOUR_WEBHOOK_URL \
#     --from-literal=prometheus-token=YOUR_TOKEN \
#     -n monitoring

apiVersion: v1
kind: Secret
metadata:
  name: green-but-dead-detector-secrets
  namespace: monitoring
  labels:
    app: green-but-dead-detector
type: Opaque
stringData:
  # Slack webhook for notifications
  # slack-webhook-url: "https://hooks.slack.com/services/YOUR/WEBHOOK/URL"
  
  # PagerDuty integration key
  # pagerduty-key: "YOUR_PAGERDUTY_INTEGRATION_KEY"
  
  # Prometheus authentication token (if needed)
  # prometheus-token: "YOUR_PROMETHEUS_TOKEN"
  
  # Custom notification URLs
  # webhook-url: "https://your-webhook-endpoint.com/notify"

---
# Example: Using secrets in the CronJob
# Add this to the container spec in cronjob.yaml:
#
# env:
# - name: SLACK_WEBHOOK_URL
#   valueFrom:
#     secretKeyRef:
#       name: green-but-dead-detector-secrets
#       key: slack-webhook-url
#
# - name: PROMETHEUS_TOKEN
#   valueFrom:
#     secretKeyRef:
#       name: green-but-dead-detector-secrets
#       key: prometheus-token
